// GLFW usa automaticamente o ícone chamado GLFW_ICON para as janelas.
GLFW_ICON ICON "kb.ico"
// Página do app para celular (servida pelo KB na rede local).
MOBILE_HTML RCDATA "mobile.html"
// Foto de fundo e logo (também é o molde das partículas "KB").
BG_JPG RCDATA "bg.jpg"
LOGO_PNG RCDATA "logo.png"

1 VERSIONINFO
FILEVERSION 1,2,2,0
PRODUCTVERSION 1,2,2,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "KB"
      VALUE "FileDescription", "KB - Assistente de voz local"
      VALUE "FileVersion", "1.2.2"
      VALUE "ProductName", "KB"
      VALUE "ProductVersion", "1.2.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
